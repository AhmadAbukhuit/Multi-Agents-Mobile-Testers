# Local Ollama configuration for Multi-Agents-Mobile-Testers
OLLAMA_HOST="${OLLAMA_HOST:-http://localhost:11434}"
OLLAMA_MODEL="${OLLAMA_MODEL:-qwen2.5vl:7b}"
OLLAMA_NUM_CTX="${OLLAMA_NUM_CTX:-32768}"
OLLAMA_TIMEOUT="${OLLAMA_TIMEOUT:-600}"

# Optional LangSmith tracing (set LANGCHAIN_TRACING_V2=true and LANGCHAIN_API_KEY to enable)
LANGCHAIN_TRACING_V2="${LANGCHAIN_TRACING_V2:-false}"
LANGCHAIN_PROJECT="${LANGCHAIN_PROJECT:-Multi-Agents-Mobile-Testers}"
LANGCHAIN_ENDPOINT="${LANGCHAIN_ENDPOINT:-https://api.smith.langchain.com}"
